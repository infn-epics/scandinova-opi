<widget type="textentry" version="3.0.0">
<name>HVPSSetEntry</name><pv_name>loc://ppt_$(P):$(R):HVPS:VoltageSet&lt;VDouble&gt;(0)</pv_name>
<x>140</x><y>5</y><width>110</width><height>26</height><format>1</format><precision>1</precision>
<show_units>false</show_units></widget>
<widget type="action_button" version="3.0.0">
<name>HVPSApplyBtn</name>
<actions><action type="execute"><script file="EmbeddedPy"><text><![CDATA[# Copy the local setpoint (HVPSSetEntry) to the real PV (this button's pv_name)
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

entry = ScriptUtil.findWidgetByName(widget, "HVPSSetEntry")
value = PVUtil.getDouble(ScriptUtil.getPrimaryPV(entry))
ScriptUtil.getPrimaryPV(widget).write(value)
]]></text></script><description>Apply Voltage</description></action></actions>
<pv_name>$(P):$(R):HVPS:VoltageSet</pv_name><text>APPLY</text>
<x>260</x><y>3</y><width>80</width><height>30</height><font><font family="Liberation Sans" style="BOLD" size="13.0"></font></font>
<foreground_color><color red="255" green="255" blue="255"></color></foreground_color><background_color><color red="0" green="100" blue="180"></color></background_color>
